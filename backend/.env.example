# R45 (fejlesztési audit, 2026-07-19) — másold `.env` néven ugyanebbe a
# mappába (backend/.env, git-ből kizárva) és töltsd ki a valós értékekkel.
# Hiányzó kulcsok esetén db.php/config.php a korábbi, hardcoded értékre
# esik vissza, tehát ez a fájl NEM kötelező a helyi futáshoz — csak akkor
# szükséges, ha ténylegesen rotált, .env-en keresztül felülírt titkokat
# akarsz használni (pl. élesben, a régi, git-historyban élő értékek
# rotálása után).

DB_HOST=localhost
DB_NAME=kamion
DB_USER=kamion
DB_PASSWORD=

API_AUTH_HASH=
NAV_ENCRYPTION_KEY=
GEMINI_API_KEY=
