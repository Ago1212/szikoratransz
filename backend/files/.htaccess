# Védelmi réteg a fileUpload() kiterjesztés-whitelistje MELLETT (nem
# helyette) — ha valamiért mégis bekerülne ide egy futtatható kiterjesztésű
# fájl, ez megakadályozza, hogy a webszerver PHP-ként értelmezze/futtassa.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
