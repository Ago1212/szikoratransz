<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Frissítéskor az embereknél ne ragadjon be a régi verzió: a hashelt
# static/ fájlok (main.[hash].js/css) örökre cache-elhetők, mert a
# tartalmuk sose változik hash-váltás nélkül — de az index.html,
# a service worker és a manifest MINDIG friss kell legyen, különben a
# böngésző/proxy a régi verziót szolgálja ki új deploy után is.
# `no-store` szándékosan NINCS itt (csak `no-cache, must-revalidate`):
# a `no-store` letiltaná a böngésző back/forward-cache-ét (lassabb
# "vissza" navigáció mindenhol), miközben a `no-cache` önmagában is
# minden betöltéskor kikényszeríti a friss verzió ellenőrzését.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|service-worker\.js|manifest\.json|asset-manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

