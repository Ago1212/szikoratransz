<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A `scripts/prerender.js` (ld. `postbuild` npm hook) mostantól lapos
  # `build/<route>.html` fájlokat hoz létre minden route-hoz (pl.
  # build/belfoldi-fuvarozas-arajanlat.html), hogy a nem-JS crawlerek is
  # lássák a tényleges tartalmat. Ez a lenti szabály a kiterjesztés nélküli
  # URL-t erre a fájlra képezi le belsőleg (redirect nélkül).
  #
  # KÉT KORÁBBI MEGKÖZELÍTÉS ÉLESBEN NEM MŰKÖDÖTT, EZ MIATT LETT LAPOS FÁJL
  # (2026-07-17, élő Apache-példányon, ugyanazzal az AllowOverride-dal
  # leellenőrizve, nem csak feltételezve): a script eredetileg alkönyvtárba
  # írt (`build/<route>/index.html`), amit Apache mod_dir-je 301-gyel a
  # per-jeles verzióra irányított át (mert a route valódi könyvtárrá vált a
  # lemezen) — ez eltért a sitemap.xml/canonical/OG tagekben szereplő, per
  # nélküli URL-formától. Sem a `DirectorySlash Off` (a hoszt
  # `AllowOverride`-ja nem ad `Indexes` kontextust — a lenti `Header`
  # irányelv viszont működik, az `FileInfo`-t igényel, ami engedélyezett),
  # sem egy könyvtár-alapú `RewriteRule` (a .htaccess-szintű RewriteRule
  # ezen a hoszton később fut le, mint mod_dir saját átirányítás-logikája)
  # nem tudta megkerülni ezt. Lapos `.html` fájllal a route sosem lesz
  # valódi könyvtár, így mod_dir-nek nincs mit átirányítania. Mivel minden
  # statikus asset abszolút, gyökér-relatív útvonalon hivatkozik (pl.
  # `/static/js/main.js`), ez nem tör el semmilyen relatív hivatkozást.
  # A mintát szándékosan `[^/]+`-ra (egyetlen útvonal-szegmens) szűkítjük,
  # NEM `.*`-ra — élő teszteléskor (helyi Apache-példányon reprodukálva)
  # kiderült, hogy egy `.*`-mintájú szabály `%{REQUEST_FILENAME}.html -f`
  # feltétellel egy létező alkönyvtár-szerű, de a lemezen valójában nem
  # létező útvonal (pl. `/belfoldi-fuvarozas-arajanlat/barmi`) esetén a
  # mod_rewrite saját "path info" heurisztikája miatt tévesen igaznak
  # értékelődik (mert `belfoldi-fuvarozas-arajanlat.html` létezik), ami
  # a szubsztitúciót minden körben egy újabb `.html` végződéssel toldja
  # meg — végtelen belső-redirect hurkot és HTTP 500-at okozva. Mivel a
  # prerender.js kimenete mindig egyetlen, lapos szegmens (ld.
  # ROUTES_TO_PRERENDER), a szűkített minta ugyanazt a viselkedést adja
  # a valódi route-okra, de kizárja ezt a hurkot bármilyen, egy
  # prerenderelt route alá írt, nem létező alútvonalra.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)$ $1.html [L]

  RewriteRule ^index\.html$ - [L]

  # A fenti szabály csak akkor talál, ha a prerender.js ténylegesen legyártotta
  # az adott route lapos .html fájlját. Ha nem (pl. a build-környezetben nem
  # sikerült elindítani a headless Chromiumot, ld. scripts/prerender.js
  # fail-safe ága), az alábbi két szabály még mindig a SPA-shellt (index.html,
  # 200) szolgálja ki, de KIZÁRÓLAG a ténylegesen létező kliensoldali
  # route-prefixekre (ld. src/index.js <Switch>-e) — minden más, ismeretlen
  # útvonal nem kap rewrite-ot, tehát a normál Apache 404-kezelésbe fut.
  # Korábban egy feltétel nélküli catch-all (`RewriteRule . /index.html`) MINDEN
  # érvénytelen URL-re 200-at adott a főoldal tartalmával (soft-404) — ez a SEO
  # audit szerint azért volt hiba, mert a Google/AI-crawlerek ezt indexelhető,
  # a főoldallal duplikált tartalomként látták.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(admin|user|auth|profile)(/.*)?$ /index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(belfoldi-fuvarozas-arajanlat|nemzetkozi-fuvarozas-vamugyintezessel|biztositott-szallitas|expressz-fuvarozas|rendezveny-szallitas|egyedi-arajanlat-fuvarozas|adatvedelem)/?$ /index.html [L]
</IfModule>

# Alap biztonsági response headerek — a SEO/technikai audit ezek teljes
# hiányát jelezte. A HSTS csak akkor biztonságos, ha a domain minden
# aldomainje is HTTPS-en fut (`includeSubDomains`) — itt igen, ld. a fenti
# HTTP→HTTPS és www→non-www redirect a szerveren.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Frissítéskor az embereknél ne ragadjon be a régi verzió: a hashelt
# static/ fájlok (main.[hash].js/css) örökre cache-elhetők, mert a
# tartalmuk sose változik hash-váltás nélkül — de az index.html,
# a service worker és a manifest MINDIG friss kell legyen, különben a
# böngésző/proxy a régi verziót szolgálja ki új deploy után is.
# `no-store` szándékosan NINCS itt (csak `no-cache, must-revalidate`):
# a `no-store` letiltaná a böngésző back/forward-cache-ét (lassabb
# "vissza" navigáció mindenhol), miközben a `no-cache` önmagában is
# minden betöltéskor kikényszeríti a friss verzió ellenőrzését.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|service-worker\.js|manifest\.json|asset-manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # A `public/`-ból változatlanul kiszolgált képek/ikonok (logo2.svg,
  # icon-*.png, a két hero kép) korábban egyáltalán nem kaptak
  # Cache-Control fejlécet — a SEO/teljesítmény-audit ezt élő fejléc-
  # vizsgálattal erősítette meg (Lighthouse `uses-long-cache-ttl` is
  # jelezte). Nem kapnak `immutable`/1 éves TTL-t, mint a hash-elt
  # static/js|css, mert a fájlnevük nem tartalmaz tartalom-hash-t — egy
  # jövőbeli csere (pl. új logó) így legfeljebb 7 napig cache-elt marad
  # elavultan, nem egy évig.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

